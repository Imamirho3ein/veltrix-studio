# آدرس نهایی سایت (بدون اسلش انتهایی)
NEXT_PUBLIC_SITE_URL=https://veltrixstudio.ir

# کد تأیید Google Search Console (فقط مقدار content متا)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ربات تلگرام — از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# آیدی عددی چت/کانال مقصد پیام‌های فرم تماس و لینک‌های تأیید جایگزین
TELEGRAM_CHAT_ID=
# یک رشته تصادفی بلند برای امنیت Webhook
TELEGRAM_WEBHOOK_SECRET=

# ارسال ایمیل (تأیید حساب کاربری) — نمونه برای جیمیل با App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=amirhosseinjadidiy@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM="Veltrix Studio <amirhosseinjadidiy@gmail.com>"

# مسیر ذخیره‌ی داده‌های کاربران و درخواست‌ها (فایل JSON).
# روی Runflare مسیر دیسک متصل را بدهید؛ خالی بماند در پوشه‌ی .data کنار پروژه ذخیره می‌شود.
# DATA_DIR=
